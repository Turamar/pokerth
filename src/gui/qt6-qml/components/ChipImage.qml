import QtQuick
import QtQuick.Window

import "../resources/chips/chipyaw.js" as ChipYaw

// One table chip from the player's chip set (resources/chips, generated by
// tools/chipgen/chipgen.py — copy of the design set in pokerth-chips).
//
// Since 2026-11-12 the chip LIES on the felt (tiers "obl" without a value and
// "obln" with it): the SVG is a squashed face (0.80 of the width) with a 10 %
// side band under it, so a single chip has thickness and a stack shows the edge
// of every lower chip. The reference client (25x20 px face) was measured for
// that; PLAN.md §6, "Фишки — не круги".
//
// The asset is a 1024x1024 canvas: the chip itself is 0.988 of the width,
// 0.89 of the height (face 0.79 + band 0.10) and centred. ChipImage keeps the
// square item size; BetChip/BetRows stack the chips by `bandStep`.
//
// The value appears from 22 screen px. `_rs` never drops below 1, so a 22 px
// chip always gets its number; the pot used to be drawn with 18 px chips and on
// a small table (`communityScale` ≈ 0.92) those fell below the threshold — the
// player reported that chips "lose their digit when they get into the pot"
// (2026-11-12). The pot now uses the same 22 px chips as a bet.
//
// The value is printed in tournaments AND at cash tables since 2026-11-12. A
// cash bet is money, and since the ladder is cents the printed value is honest
// exactly (the old worry "a printed 100 would mean $1" is gone because the
// smallest chip is 1¢): a cent chip carries the cent sign ("1¢", "5¢", "10¢",
// "25¢"), a dollar chip just its number ("1", "5", "25", "100", "500") — "$500"
// would have to shrink against "$100" to stay in the inlay. `cash` picks the
// LABELLED set (chip_c5_obln.svg); the unnumbered tier ("obl", e.g. the chip in
// a plate / a bet base) uses the same bodies in both modes, except the bronze
// penny, which has no tournament twin (`spare_bronze`). `value` 0 is the neutral
// spare chip for an amount below the smallest denomination of the ladder.
//
// Rasterisation: the SVG is rasterised at the real screen pixel size
// (logical size × parent scale × devicePixelRatio), exactly like CardImage:
// the QML Image rasterises an SVG to its LOGICAL size, and a parent `scale`
// would blow the finished texture up on the GPU side → blurry.
Item {
    id: chip

    // Ladder value of the chip (1 … 50000), 0 = the neutral spare chip.
    property int value: 5
    // Diameter (width) in the caller's logical (table base) pixels.
    property int chipSize: 22
    // Effective screen scale of the parents (boxScale/oppScale/communityScale × zoom).
    property real renderScale: 1
    // Cash table (money labels) instead of tournament chips (chip counts).
    property bool cash: false
    // Lying geometry (the table chips). false = the old round top-down tiers,
    // kept so that a caller can still ask for the flat look.
    property bool lying: true
    // Turn of the chip about the VERTICAL axis, degrees (2026-11-17). A chip
    // lying on the felt can only be turned that way, and that turn is NOT a
    // rotation of the picture: `rotation` would turn the projection with it (the
    // squeeze of the lying asset would tilt and the chip would read as standing
    // on its edge — the player's report). The turn is baked into the asset as a
    // separate frame of the WHOLE chip: the printed parts of the face are turned
    // in the chip plane and squashed after that, the rim colours of the side band
    // turn with the rim, the light stays put (tools/chipgen/chipgen.py,
    // --oblique-yaws). Frames exist every 10° up to ±30°; the angle is quantised
    // to the nearest frame (invisible at table size) and 0 is the plain asset.
    property real yaw: 0

    // The frame actually drawn; its tag goes into the file name, "" for 0°. Frames
    // exist for the numbered lying tier only (an unnumbered chip has no print to
    // turn, and the band stripes are the same at any angle at this size).
    readonly property real _yawFrame: lying ? ChipYaw.frame(yaw) : 0

    width: chipSize
    height: chipSize

    readonly property real _rs: Math.max(1.0, renderScale)
    readonly property real _screenPx: chipSize * _rs
    readonly property real _dpr: Screen.devicePixelRatio > 0 ? Screen.devicePixelRatio : 1

    // The file name inside the set (`chip_<name>_<tier>.svg`).
    // Tournament chips count chips, the cash ones count money (see the header):
    // the same body carries different values, so the labelled asset differs.
    function tournamentName(v) {
        switch (v) {
        case 5:     return "5"
        case 10:    return "10"
        case 25:    return "25"
        case 100:   return "100"
        case 500:   return "500"
        case 2500:  return "2500"
        case 10000: return "10000"
        case 50000: return "50000"
        default:    return "spare_ink"       // 0 = neutral, no denomination
        }
    }
    // Cash labels: 1¢/5¢/10¢/25¢ and the dollar rungs as plain numbers. The small
    // chip (tier "obl", no room for the value) uses the tournament bodies — only
    // the bronze penny has no tournament twin.
    function cashName(v, tier) {
        if (tier === "obln") {
            switch (v) {
            case 1:     return "c1"
            case 5:     return "c5"
            case 10:    return "c10"
            case 25:    return "c25"
            case 100:   return "d1"
            case 500:   return "d5"
            case 2500:  return "d25"
            case 10000: return "d100"
            case 50000: return "d500"
            default:    return "spare_ink"
            }
        }
        return v === 1 ? "spare_bronze" : tournamentName(v)
    }
    function chipName(v, tier) {
        return cash ? cashName(v, tier) : tournamentName(v)
    }
    readonly property bool _numbered: value > 0
    readonly property string _tier: {
        if (lying) {
            // the lying set carries numbers for every ladder rung of the mode
            return (_numbered && _screenPx >= 22) ? "obln" : "obl"
        }
        return (_numbered && _screenPx >= 24) ? "tnum"
             : (_screenPx >= 21 ? "lg" : "sm")
    }
    readonly property int _rasterPx: Math.max(1, Math.ceil(_screenPx * _dpr))

    // ONE binding builds the whole file name from a single tier snapshot: the name
    // and the yaw-frame tag both depend on the tier, and a mixed stale pair asks for
    // a file that does not exist (a `chip_spare_bronze_obl_yp20.svg` was logged when
    // `renderScale` dropped after the yaw had already been rolled). A plain chip has
    // the tag "".
    readonly property string _source: {
        var tier = chip._tier
        var tag = (tier === "obln") ? ChipYaw.tag(chip._yawFrame) : ""
        return "../resources/chips/chip_" + chipName(chip.value, tier)
             + "_" + tier + tag + ".svg"
    }

    // Geometry of the lying asset, in item (logical) units. A stack is built by
    // offsetting the next chip up by exactly `bandStep`; then every lower chip
    // shows only its own side.
    readonly property real faceHeight: 0.7906 * chipSize     // 2R·0.80 of the canvas
    readonly property real bandStep: 0.0988 * chipSize       // 0.10·2R of the canvas
    // Visual bottom/top of the chip inside the square item (for stacking maths).
    readonly property real chipBottom: chipSize / 2 + (faceHeight + bandStep) / 2
    readonly property real chipTop: chipSize / 2 - (faceHeight + bandStep) / 2

    Image {
        anchors.fill: parent
        // A relative path works in both modes: from disk (POKERTH_QML_DIR dev
        // mode) it resolves next to this file, in the compiled build relative to
        // qrc:/components/ → qrc:/resources/chips/… (the qrc keeps the tree flat).
        source: chip._source
        sourceSize.width: chip._rasterPx
        sourceSize.height: chip._rasterPx
        fillMode: Image.PreserveAspectFit
        smooth: true
        mipmap: true
    }
}
