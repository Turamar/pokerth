import QtQuick
import QtQuick.Window

// One table chip from the player's chip set (resources/chips, generated by
// tools/chipgen/chipgen.py — copy of the design set in pokerth-chips).
//
// Since 2026-11-12 the chip LIES on the felt (tiers "obl" without a value and
// "obln" with it): the SVG is a squashed face (0.80 of the width) with a 6 %
// side band under it, so a single chip has thickness and a stack shows the edge
// of every lower chip. The reference client (25x20 px face) was measured for
// that; PLAN.md §6, "Фишки — не круги".
//
// The asset is a 1024x1024 canvas: the chip itself is 0.988 of the width,
// 0.85 of the height (face 0.79 + band 0.06) and centred. ChipImage keeps the
// square item size; BetChip/BetRows stack the chips by `bandStep`.
//
// The value is printed only in tournaments: the cash ladder counts cents, so a
// printed "100" would mean $1 and lie. `value` 0 is the neutral fallback chip
// for an amount below the smallest denomination — the spare chip without a value.
//
// Rasterisation: the SVG is rasterised at the real screen pixel size
// (logical size × parent scale × devicePixelRatio), exactly like CardImage:
// the QML Image rasterises an SVG to its LOGICAL size, and a parent `scale`
// would blow the finished texture up on the GPU side → blurry.
Item {
    id: chip

    // Ladder value of the chip (5 … 50000), 0 = the neutral spare chip.
    property int value: 5
    // Diameter (width) in the caller's logical (table base) pixels.
    property int chipSize: 22
    // Effective screen scale of the parents (boxScale/oppScale/communityScale × zoom).
    property real renderScale: 1
    // Print the denomination (tournaments only — see the header).
    property bool digits: false
    // Lying geometry (the table chips). false = the old round top-down tiers,
    // kept so that a caller can still ask for the flat look.
    property bool lying: true

    width: chipSize
    height: chipSize

    readonly property real _rs: Math.max(1.0, renderScale)
    readonly property real _screenPx: chipSize * _rs
    readonly property real _dpr: Screen.devicePixelRatio > 0 ? Screen.devicePixelRatio : 1

    // The file name inside the set (`chip_<name>_<tier>.svg`).
    readonly property string _name: {
        switch (value) {
        case 5:     return "5"
        case 10:    return "10"
        case 25:    return "25"
        case 100:   return "100"
        case 500:   return "500"
        case 2500:  return "2500"
        case 10000: return "10000"
        case 50000: return "50000"
        default:    return "spare_ink"       // 0 = neutral, no denomination
        }
    }
    readonly property bool _numbered: _name !== "spare_ink" && _name !== "spare_bronze"
    readonly property string _tier: {
        if (lying) {
            // the lying set only carries numbers for the eight denominations
            return (digits && _numbered && _screenPx >= 22) ? "obln" : "obl"
        }
        return (digits && _numbered && _screenPx >= 24) ? "tnum"
             : (_screenPx >= 21 ? "lg" : "sm")
    }
    readonly property int _rasterPx: Math.max(1, Math.ceil(_screenPx * _dpr))

    // Geometry of the lying asset, in item (logical) units. A stack is built by
    // offsetting the next chip up by exactly `bandStep`; then every lower chip
    // shows only its own side.
    readonly property real faceHeight: 0.7906 * chipSize     // 2R·0.80 of the canvas
    readonly property real bandStep: 0.0593 * chipSize       // 0.06·2R of the canvas
    // Visual bottom/top of the chip inside the square item (for stacking maths).
    readonly property real chipBottom: chipSize / 2 + (faceHeight + bandStep) / 2
    readonly property real chipTop: chipSize / 2 - (faceHeight + bandStep) / 2

    Image {
        anchors.fill: parent
        // A relative path works in both modes: from disk (POKERTH_QML_DIR dev
        // mode) it resolves next to this file, in the compiled build relative to
        // qrc:/components/ → qrc:/resources/chips/… (the qrc keeps the tree flat).
        source: "../resources/chips/chip_" + chip._name + "_" + chip._tier + ".svg"
        sourceSize.width: chip._rasterPx
        sourceSize.height: chip._rasterPx
        fillMode: Image.PreserveAspectFit
        smooth: true
        mipmap: true
    }
}
